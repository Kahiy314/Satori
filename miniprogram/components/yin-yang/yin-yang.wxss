/* 阴阳鱼动画组件 */
.yin-yang-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.symbol-wrapper {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  margin-bottom: 30rpx;
}

.symbol-wrapper.spinning {
  animation: rotate 8s linear infinite;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 阴阳鱼使用 CSS 实现 */
.yin-yang-symbol {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
}

/* 阳面（白）*/
.yin-yang-symbol.yang {
  background: white;
  border: 2px solid #5d4037;
}

.yang-fill {
  position: absolute;
  bottom: 50%;
  left: 0;
  right: 0;
  height: 50%;
  background: white;
}

.yang-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  background: #5d4037;
  border-radius: 50%;
}

/* 阴面（黑）*/
.yin-yang-symbol.yin {
  background: #333;
  border: 2px solid #5d4037;
}

.yin-fill {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 50%;
  background: #333;
}

.yin-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  background: white;
  border-radius: 50%;
}

/* 更简洁的实现：使用 SVG */
.yin-yang-container::before {
  content: '';
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  background: conic-gradient(white 0deg 180deg, #333 180deg 360deg);
  border-radius: 50%;
  border: 3px solid #5d4037;
  box-shadow: 0 4rpx 15rpx rgba(93, 64, 55, 0.2);
}

.yin-yang-container::after {
  content: '';
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 25%, transparent 38rpx, #333 38rpx),
              radial-gradient(circle at 50% 75%, transparent 38rpx, white 38rpx);
}

/* 覆盖上面的伪元素，用更简洁的方案 */
.yin-yang-container {
  position: relative;
}

/* 使用 emoji 旋转作为简单方案 */
.symbol-wrapper {
  font-size: 0;
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.symbol-wrapper::before {
  content: '☯️';
  font-size: 180rpx;
  display: block;
  text-align: center;
  line-height: 200rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(93, 64, 55, 0.2));
}

.symbol-wrapper.spinning::before {
  animation: spinEmoji 6s linear infinite;
}

@keyframes spinEmoji {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.spin-hint {
  font-size: 24rpx;
  color: #8c7b6c;
  font-style: italic;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.spin-hint.show {
  opacity: 1;
}
