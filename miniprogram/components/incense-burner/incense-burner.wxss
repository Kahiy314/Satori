/* 焚香动画组件 */
/*
  图片命名与放置规范
  ============================================================
  路径：miniprogram/assets/images/

  1. incense-burner.png（香炉图片）
     - 尺寸：建议 300×300px，宽高比约 1:1
     - 格式：PNG（推荐透明背景）
     - 内容：香炉主体居中，顶部留出插入香的空白区域
     - 可用设计工具（Sketch/Figma/PS）绘制国风香炉外形，
       内部留空以便香棒插入

  2. 可选：incense-stick.png（香棒图片）
     - 尺寸：建议 20×200px
     - 格式：PNG（透明背景）
     - 如不使用，组件会用 CSS 渲染香棒

  示例目录结构：
  miniprogram/
    assets/
      images/
        incense-burner.png   ← 香炉图片
        incense-stick.png     ← 香棒图片（可选）
============================================================
*/

.incense-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 20rpx 0;
  opacity: 0.4;
  transition: opacity 0.5s ease;
}

.incense-container.active {
  opacity: 1;
}

/* ========== 香棒区域 ========== */
.stick-section {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: -10rpx;
  z-index: 1;
}

.stick-wrapper {
  position: relative;
  width: 12rpx;
  height: 360rpx;
  border-radius: 6rpx;
  overflow: hidden;
}

.stick-burned {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  background: #9e8e7e;
  border-radius: 6rpx 6rpx 0 0;
}

.stick-remaining {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(to top, #8b6914, #c49a3c, #d4a373);
  border-radius: 0 0 6rpx 6rpx;
}

/* ========== 火焰效果 ========== */
.flame-wrapper {
  position: absolute;
  left: 50%;
  transform: translate(-50%, -100%);
  width: 60rpx;
  height: 60rpx;
  z-index: 2;
  pointer-events: none;
}

.flame {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  animation: flicker 0.4s ease-in-out infinite alternate;
}

.flame-1 {
  width: 28rpx;
  height: 50rpx;
  background: radial-gradient(ellipse at 50% 80%, #ff9800 0%, #ff5722 50%, transparent 100%);
  filter: blur(1rpx);
}

.flame-2 {
  width: 18rpx;
  height: 36rpx;
  bottom: 4rpx;
  background: radial-gradient(ellipse at 50% 70%, #ffcc02 0%, #ff9800 60%, transparent 100%);
  animation-delay: 0.1s;
}

.flame-3 {
  width: 10rpx;
  height: 24rpx;
  bottom: 8rpx;
  background: radial-gradient(ellipse at 50% 60%, #fff176 0%, #ffcc02 60%, transparent 100%);
  animation-delay: 0.2s;
}

/* 外焰光晕 */
.flame-wrapper::before {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 80rpx;
  background: radial-gradient(circle, rgba(255, 152, 0, 0.3) 0%, transparent 70%);
  border-radius: 50%;
  animation: glow 0.6s ease-in-out infinite alternate;
}

@keyframes flicker {
  0% { transform: translateX(-50%) scaleY(1) scaleX(1); }
  25% { transform: translateX(-50%) scaleY(1.08) scaleX(0.92) rotate(-2deg); }
  50% { transform: translateX(-50%) scaleY(0.95) scaleX(1.05) rotate(1deg); }
  75% { transform: translateX(-50%) scaleY(1.05) scaleX(0.95) rotate(-1deg); }
  100% { transform: translateX(-50%) scaleY(1) scaleX(1); }
}

@keyframes glow {
  0% { opacity: 0.5; transform: translateX(-50%) scale(0.9); }
  100% { opacity: 0.8; transform: translateX(-50%) scale(1.1); }
}

/* ========== 火星 ========== */
.spark {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #ffcc02;
  border-radius: 50%;
  bottom: 40rpx;
  left: 50%;
  animation: sparkFly 1.2s ease-out infinite;
}

.spark:nth-child(4) { left: 30%; animation-delay: 0.2s; }
.spark:nth-child(5) { left: 70%; animation-delay: 0.6s; }

@keyframes sparkFly {
  0% {
    opacity: 1;
    transform: translateY(0) translateX(0) scale(1);
  }
  50% {
    opacity: 0.8;
  }
  100% {
    opacity: 0;
    transform: translateY(-80rpx) translateX(15rpx) scale(0.3);
  }
}

/* ========== 香炉图片 ========== */
.burner-section {
  width: 300rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 0;
}

.burner-img {
  width: 100%;
  height: 100%;
}
