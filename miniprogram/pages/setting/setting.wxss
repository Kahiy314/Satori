/* 设置页面样式 */
.setting-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8f4e9 0%, #f0e6d6 100%);
  padding: 30rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #5d4037;
  text-align: center;
  margin-bottom: 40rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(140, 123, 108, 0.1);
}

.setting-section {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(140, 123, 108, 0.1);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 25rpx;
}

/* 主题选项 */
.theme-options {
  display: flex;
  justify-content: space-between;
}

.theme-option {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f8f4e9;
  border: 1px solid #e8e0d0;
  border-radius: 15rpx;
  flex: 1;
  margin: 0 10rpx;
  transition: all 0.3s ease;
}

.theme-option.selected {
  background: #d4a373;
  border-color: #b08c5a;
}

.option-radio {
  width: 30rpx;
  height: 30rpx;
  border: 2px solid #8c7b6c;
  border-radius: 50%;
  margin-right: 15rpx;
  position: relative;
}

.option-radio.selected {
  border-color: white;
}

.option-radio.selected::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background: white;
  border-radius: 50%;
}

.option-label {
  font-size: 26rpx;
  color: #5d4037;
}

.theme-option.selected .option-label {
  color: white;
}

/* 下拉选择器 */
.dropdown-select {
  position: relative;
}

.select-current {
  background: #f8f4e9;
  border: 1px solid #e8e0d0;
  border-radius: 15rpx;
  padding: 25rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.current-text {
  font-size: 26rpx;
  color: #5d4037;
}

.dropdown-icon {
  font-size: 20rpx;
  color: #8c7b6c;
}

.select-options {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #e8e0d0;
  border-radius: 0 0 15rpx 15rpx;
  z-index: 10;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.dropdown-select:active .select-options {
  max-height: 400rpx;
}

.select-option {
  display: flex;
  align-items: center;
  padding: 20rpx 25rpx;
  border-bottom: 1px solid #f0f0f0;
}

.select-option:last-child {
  border-bottom: none;
}

.select-option.selected {
  background: #f8f4e9;
}

.option-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.option-text {
  flex: 1;
  font-size: 26rpx;
  color: #5d4037;
}

.checkmark {
  font-size: 24rpx;
  color: #d4a373;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.checkmark.show {
  opacity: 1;
}

/* 时长控制 */
.duration-control {
  display: flex;
  justify-content: center;
}

.control-wrapper {
  display: flex;
  align-items: center;
  background: #f8f4e9;
  border: 1px solid #e8e0d0;
  border-radius: 25rpx;
  padding: 15rpx;
}

.control-btn {
  width: 60rpx;
  height: 60rpx;
  background: #d4a373;
  color: white;
  border: none;
  border-radius: 50%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
}

.control-btn:active {
  background: #b08c5a;
}

.duration-display {
  display: flex;
  align-items: baseline;
  min-width: 120rpx;
  text-align: center;
}

.duration-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #5d4037;
  margin-right: 10rpx;
}

.duration-unit {
  font-size: 24rpx;
  color: #8c7b6c;
}

/* 关于信息 */
.about-info {
  background: #f8f4e9;
  border: 1px solid #e8e0d0;
  border-radius: 15rpx;
  padding: 25rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.version {
  font-size: 26rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 10rpx;
}

.description {
  font-size: 22rpx;
  color: #8c7b6c;
}