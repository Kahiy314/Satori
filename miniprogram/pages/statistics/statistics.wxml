<!-- 统计页面 -->
<view class="statistics-page">
  <!-- 数据看板 -->
  <view class="stats-board">
    <view class="board-title">📊 数据看板</view>

    <!-- 数据表格 -->
    <view class="stats-table">
      <view class="stats-table-row">
        <view class="stats-table-cell">
          <view class="cell-value">{{statsData.todayFocus}}</view>
          <view class="cell-label">今日专注</view>
          <view class="cell-unit">分钟</view>
        </view>
        <view class="stats-table-cell">
          <view class="cell-value">{{statsData.todayTasks}}</view>
          <view class="cell-label">今日完成</view>
          <view class="cell-unit">个</view>
        </view>
        <view class="stats-table-cell">
          <view class="cell-value">{{statsData.weekFocus}}</view>
          <view class="cell-label">本周专注</view>
          <view class="cell-unit">分钟</view>
        </view>
      </view>
      <view class="stats-table-divider"></view>
      <view class="stats-table-row">
        <view class="stats-table-cell">
          <view class="cell-value">{{statsData.weekTasks}}</view>
          <view class="cell-label">本周完成</view>
          <view class="cell-unit">个</view>
        </view>
        <view class="stats-table-cell">
          <view class="cell-value">{{statsData.totalFocus}}</view>
          <view class="cell-label">总专注</view>
          <view class="cell-unit">分钟</view>
        </view>
        <view class="stats-table-cell">
          <view class="cell-value">{{statsData.totalTasks}}</view>
          <view class="cell-label">总任务</view>
          <view class="cell-unit">个</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 专注趋势图 -->
  <view class="trend-section">
    <view class="section-title">📈 近7天专注趋势</view>
    <view class="trend-chart">
      <!-- Y轴刻度 -->
      <view class="chart-y-axis">
        <text class="y-label" wx:for="{{yAxisLabels}}" wx:key="index">{{item}}</text>
      </view>

      <!-- 图表主体 -->
      <view class="chart-body">
        <!-- 网格背景 -->
        <view class="chart-grid">
          <view class="grid-row" wx:for="{{7}}" wx:key="index"></view>
        </view>

        <!-- 折线连接（SVG路径） -->
        <view class="chart-line-svg">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none">
            <polyline
              points="{{linePoints}}"
              fill="none"
              stroke="#d4a373"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle
              cx="{{item.x}}"
              cy="{{item.y}}"
              r="3"
              fill="#d4a373"
              wx:for="{{dotPositions}}"
              wx:key="index"
            />
          </svg>
        </view>

        <!-- 数据点（可点击/悬停显示数值） -->
        <view class="chart-dots">
          <view
            class="chart-dot"
            wx:for="{{trendData}}"
            wx:key="day"
            style="left: {{item.xPercent}}%; bottom: {{item.yPercent}}%"
          >
            <view class="dot-circle"></view>
          </view>
        </view>

        <!-- X轴日期标签 -->
        <view class="chart-x-axis">
          <text class="x-label" wx:for="{{trendData}}" wx:key="day">{{item.day}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- AI学习总结 -->
  <view class="ai-section">
    <view class="section-title">🤖 AI学习总结</view>
    <view class="ai-card">
      <view class="ai-content">{{aiSummary.content}}</view>
      <view class="ai-footer">
        <text class="update-time">更新于：{{aiSummary.lastUpdate}}</text>
        <view class="refresh-btn" bindtap="refreshAI">🔄 刷新</view>
      </view>
    </view>
  </view>
</view>
