/* 统计页面样式 */
.statistics-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8f4e9 0%, #f0e6d6 100%);
  padding: 30rpx;
}

/* 数据看板 */
.stats-board {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(140, 123, 108, 0.1);
}

.board-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 数据表格（三等分布局） */
.stats-table {
  background: #f8f4e9;
  border: 1px solid #e8e0d0;
  border-radius: 15rpx;
  overflow: hidden;
}

.stats-table-row {
  display: flex;
}

.stats-table-divider {
  height: 1px;
  background: #e8e0d0;
}

.stats-table-cell {
  flex: 1;
  padding: 25rpx 15rpx;
  text-align: center;
  border-right: 1px solid #e8e0d0;
}

.stats-table-cell:last-child {
  border-right: none;
}

.cell-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #d4a373;
  margin-bottom: 6rpx;
}

.cell-label {
  font-size: 24rpx;
  color: #8c7b6c;
  margin-bottom: 4rpx;
}

.cell-unit {
  font-size: 20rpx;
  color: #a1887f;
}

/* 趋势图区域 */
.trend-section {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(140, 123, 108, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 图表整体布局 */
.trend-chart {
  display: flex;
}

/* Y轴刻度 */
.chart-y-axis {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-bottom: 50rpx;
}

.y-label {
  font-size: 22rpx;
  color: #5d4037;
  text-align: right;
  padding-right: 20rpx;
  font-weight: 500;
}

/* 图表主体 */
.chart-body {
  flex: 1;
  position: relative;
  height: 320rpx;
}

/* 网格背景 */
.chart-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 50rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.grid-row {
  height: 1px;
  background: #e8e0d0;
  position: relative;
}

.grid-row::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: #f0ece6;
}

/* SVG折线 */
.chart-line-svg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 50rpx;
}

.chart-line-svg svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* 数据点 */
.chart-dots {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 50rpx;
}

.chart-dot {
  position: absolute;
  transform: translate(-50%, 50%);
}

.dot-circle {
  width: 14rpx;
  height: 14rpx;
  background: #d4a373;
  border-radius: 50%;
  border: 3rpx solid white;
  box-shadow: 0 0 0 3rpx #d4a373;
}

/* X轴日期标签 */
.chart-x-axis {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
}

.x-label {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #5d4037;
  font-weight: 500;
}

/* AI学习总结 */
.ai-section {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(140, 123, 108, 0.1);
}

.ai-card {
  background: #f8f4e9;
  border-radius: 15rpx;
  padding: 25rpx;
  border: 1px solid #e8e0d0;
}

.ai-content {
  font-size: 26rpx;
  color: #5d4037;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.ai-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.update-time {
  font-size: 22rpx;
  color: #8c7b6c;
}

.refresh-btn {
  background: #d4a373;
  color: white;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
