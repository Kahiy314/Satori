/* 统计页面样式 */
.statistics-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8f4e9 0%, #f0e6d6 100%);
  padding: 30rpx;
}

/* 数据看板 */
.stats-board {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(140, 123, 108, 0.1);
}

.board-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 数据表格（三等分布局） */
.stats-table {
  background: #f8f4e9;
  border: 1px solid #e8e0d0;
  border-radius: 15rpx;
  overflow: hidden;
}

.stats-table-row {
  display: flex;
}

.stats-table-divider {
  height: 1px;
  background: #e8e0d0;
}

.stats-table-cell {
  flex: 1;
  padding: 25rpx 15rpx;
  text-align: center;
  border-right: 1px solid #e8e0d0;
}

.stats-table-cell:last-child {
  border-right: none;
}

.cell-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #d4a373;
  margin-bottom: 6rpx;
}

.cell-label {
  font-size: 24rpx;
  color: #8c7b6c;
  margin-bottom: 4rpx;
}

.cell-unit {
  font-size: 20rpx;
  color: #a1887f;
}

.empty-state {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fffaf1;
  border: 1px dashed #d4a373;
  border-radius: 15rpx;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8c7b6c;
  line-height: 1.6;
}

/* 趋势图区域 */
.trend-section {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(140, 123, 108, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 图表整体布局 */
.trend-chart {
  display: flex;
}

/* Y轴刻度 */
.chart-y-axis {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 270rpx;
  padding-top: 0;
}

.y-label {
  font-size: 22rpx;
  color: #5d4037;
  text-align: right;
  padding-right: 20rpx;
  font-weight: 500;
}

/* body + x轴标签的垂直容器 */
.trend-chart-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 画布 */
.chart-canvas {
  width: 100%;
  height: 270rpx;
  display: block;
}

/* 日期标签 */
.chart-x-axis {
  width: 100%;
  position: relative;
  height: 50rpx;
  pointer-events: none;
}

.x-label {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #5d4037;
  font-weight: 500;
}

/* AI学习总结 */
.ai-section {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(140, 123, 108, 0.1);
}

.ai-card {
  background: #f8f4e9;
  border-radius: 15rpx;
  padding: 25rpx;
  border: 1px solid #e8e0d0;
}

.ai-content {
  font-size: 26rpx;
  color: #5d4037;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.ai-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.update-time {
  font-size: 22rpx;
  color: #8c7b6c;
}

.refresh-btn {
  background: #d4a373;
  color: white;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
