[
  {
    "id": 1,
    "text": "学而时习之，不亦说乎",
    "source": "《论语·学而》",
    "category": "论语"
  },
  {
    "id": 2,
    "text": "三人行，必有我师焉",
    "source": "《论语·述而》",
    "category": "论语"
  },
  {
    "id": 3,
    "text": "知之为知之，不知为不知，是知也",
    "source": "《论语·为政》",
    "category": "论语"
  },
  {
    "id": 4,
    "text": "学而不思则罔，思而不学则殆",
    "source": "《论语·为政》",
    "category": "论语"
  },
  {
    "id": 5,
    "text": "己所不欲，勿施于人",
    "source": "《论语·颜渊》",
    "category": "论语"
  },
  {
    "id": 6,
    "text": "大学之道，在明明德，在亲民，在止于至善",
    "source": "《大学》",
    "category": "大学"
  },
  {
    "id": 7,
    "text": "苟日新，日日新，又日新",
    "source": "《大学》",
    "category": "大学"
  },
  {
    "id": 8,
    "text": "物格而后知至，知至而后意诚",
    "source": "《大学》",
    "category": "大学"
  },
  {
    "id": 9,
    "text": "天命之谓性，率性之谓道，修道之谓教",
    "source": "《中庸》",
    "category": "中庸"
  },
  {
    "id": 10,
    "text": "博学之，审问之，慎思之，明辨之，笃行之",
    "source": "《中庸》",
    "category": "中庸"
  },
  {
    "id": 11,
    "text": "人皆可以为尧舜",
    "source": "《孟子·告子下》",
    "category": "孟子"
  },
  {
    "id": 12,
    "text": "天将降大任于斯人也，必先苦其心志",
    "source": "《孟子·告子下》",
    "category": "孟子"
  },
  {
    "id": 13,
    "text": "生于忧患，死于安乐",
    "source": "《孟子·告子下》",
    "category": "孟子"
  },
  {
    "id": 14,
    "text": "富贵不能淫，贫贱不能移，威武不能屈",
    "source": "《孟子·滕文公下》",
    "category": "孟子"
  },
  {
    "id": 15,
    "text": "故君子必慎其独也",
    "source": "《大学》",
    "category": "大学"
  },
  {
    "id": 16,
    "text": "君子求诸己，小人求诸人",
    "source": "《论语·卫灵公》",
    "category": "论语"
  },
  {
    "id": 17,
    "text": "逝者如斯夫，不舍昼夜",
    "source": "《论语·子罕》",
    "category": "论语"
  },
  {
    "id": 18,
    "text": "见贤思齐焉，见不贤而内自省也",
    "source": "《论语·里仁》",
    "category": "论语"
  },
  {
    "id": 19,
    "text": "吾十有五而志于学，三十而立",
    "source": "《论语·为政》",
    "category": "论语"
  },
  {
    "id": 20,
    "text": "志不强者智不达",
    "source": "《墨子》",
    "category": "其他"
  }
]
